# Copy to apps/api/.env (local) or deploy/.env.prod (VPS Docker Compose)

# --- API ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amosmind?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
PORT=3001
CORS_ORIGIN=http://localhost:3000

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=amos-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/amos-assets
# 本地 MinIO 桶公开读；生产私有桶可设为 false，仅用 ASSET_PUBLIC_BASE_URL 代理
S3_PUBLIC_READ=true
# 浏览器展示图片用（走 GET /assets/...，不要直接暴露 MinIO 内网地址）
ASSET_PUBLIC_BASE_URL=http://localhost:3001

# Model: mock | siliconflow | dashscope
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_API_URL=https://api.siliconflow.cn/v1
MODEL_TEXT2IMG=Qwen/Qwen-Image
GENERATION_COST=10
MOCK_DELAY_MS=3000

# Seed user（本地开发默认值；VPS 预发布务必改为强密码）
SEED_EMAIL=dev@amosmind.local
SEED_PASSWORD=dev123456
SEED_CREDITS=98775

# --- Web (apps/web/.env.local 或 Docker build arg) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# 腾讯云轻量 VPS 预发布示例（公网 IP 联调，Nginx 将 /api 反代到 Nest）
# 复制 deploy/.env.prod.example → deploy/.env.prod 并替换 YOUR_PUBLIC_IP
# =============================================================================
#
# POSTGRES_PASSWORD=随机强密码
# MINIO_ROOT_USER=随机用户名
# MINIO_ROOT_PASSWORD=随机强密码
#
# DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@postgres:5432/amosmind?schema=public
# REDIS_HOST=redis
# REDIS_PORT=6379
# JWT_SECRET=随机32字符以上
# CORS_ORIGIN=http://YOUR_PUBLIC_IP
# ASSET_PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP/api
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=与 MINIO_ROOT_USER 一致
# S3_SECRET_KEY=与 MINIO_ROOT_PASSWORD 一致
# MODEL_PROVIDER=siliconflow
# MODEL_API_KEY=你的硅基流动 Key
# SEED_PASSWORD=预发布强密码（与本地 dev123456 不同）
#
# NEXT_PUBLIC_API_URL=http://YOUR_PUBLIC_IP/api
