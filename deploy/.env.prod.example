# 复制为 deploy/.env.prod 并替换 YOUR_PUBLIC_IP 与所有 CHANGE_ME
# docker compose -f docker-compose.prod.yml --env-file deploy/.env.prod up -d --build

# --- 公网访问（Nginx 80 端口）---
PUBLIC_IP=YOUR_PUBLIC_IP
NEXT_PUBLIC_API_URL=http://YOUR_PUBLIC_IP/api

# --- Postgres ---
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password

# --- API ---
JWT_SECRET=CHANGE_ME_jwt_at_least_32_chars_random
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://YOUR_PUBLIC_IP
ASSET_PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP/api

MODEL_PROVIDER=siliconflow
MODEL_API_KEY=CHANGE_ME_siliconflow_key
MODEL_API_URL=https://api.siliconflow.cn/v1
MODEL_TEXT2IMG=Qwen/Qwen-Image
MODEL_VISION=Qwen/Qwen3-VL-8B-Instruct
GENERATION_COST=10

S3_BUCKET=amos-assets
S3_REGION=us-east-1
S3_PUBLIC_READ=true

SEED_EMAIL=dev@amosmind.local
SEED_PASSWORD=CHANGE_ME_staging_login_password
SEED_CREDITS=98775
